{
  "root": true,
  "$schema": "https://biomejs.dev/schemas/2.3.14/schema.json",
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true,
      "correctness": {
        "useExhaustiveDependencies": {
          "level": "error",
          "options": {
            "hooks": [
              { "name": "useReactive", "stableResult": true },
              { "name": "useMemoizedFn", "stableResult": true },
              { "name": "useLatest", "stableResult": true }
            ]
          }
        }
      }
    }
  },
  "files": {
    "includes": [
      "src/**/*.{ts,tsx,js,jsx}",
      "scripts/**/*.{js,mjs,cjs}",
      "*.json",
      "*.ts",
      "*.cjs",
      "!!dist",
      "!!node_modules"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 120
  }
}
