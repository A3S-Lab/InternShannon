{
	"name": "@internshannon/desktop",
	"private": true,
	"version": "0.2.3",
	"scripts": {
		"preinstall": "npx only-allow pnpm",
		"clean": "rimraf src-tauri/target && rimraf node_modules",
		"build": "pnpm tauri:build && pnpm check:sidecar-resources",
		"doctor": "node scripts/desktop-doctor.mjs",
		"doctor:test": "node --test scripts/desktop-doctor-state.spec.mjs",
		"stage:sidecar": "node scripts/stage-sidecar-resources.mjs",
		"stage:search-browser": "node scripts/stage-search-browser-resource.mjs",
		"download:search-browser": "node scripts/stage-search-browser-resource.mjs --download",
		"clean:search-browser": "node scripts/stage-search-browser-resource.mjs --clean",
		"stage:sidecar:standalone": "node scripts/stage-sidecar-resources.mjs --standalone",
		"stage:node-runtime": "node scripts/stage-node-runtime.mjs",
		"clean:node-runtime": "node scripts/stage-node-runtime.mjs --clean",
		"check:sidecar-resources": "node scripts/verify-sidecar-resources.mjs",
		"check:standalone-sidecar": "node scripts/verify-sidecar-resources.mjs --require-standalone",
		"check:sdk-runtime": "node scripts/verify-sdk-runtime.mjs --require-controlled",
		"check:a3s-matrix": "node scripts/verify-controlled-a3s-matrix.mjs",
		"check:search-browser": "node scripts/verify-search-browser-resource.mjs",
		"test:release-contracts": "node --test scripts/bundle-resource-cleanliness.spec.mjs scripts/controlled-a3s-package.spec.mjs scripts/npm-process.spec.mjs scripts/release-windows-contract.spec.mjs scripts/resource-directory.spec.mjs scripts/stage-node-runtime.spec.mjs scripts/stage-search-browser-resource.spec.mjs scripts/verify-controlled-a3s-matrix.spec.mjs scripts/verify-sdk-runtime.spec.mjs scripts/search-browser-resource-state.spec.mjs scripts/verify-search-browser-resource.spec.mjs ../../packaging/rc/scripts/controlled-a3s-native-host.spec.mjs ../../packaging/rc/scripts/restore-controlled-a3s.spec.mjs ../../packaging/rc/scripts/verify-controlled-a3s-install.spec.mjs",
		"smoke:standalone-sidecar": "node scripts/smoke-standalone-sidecar.mjs",
		"smoke:unicode-provider-websocket": "node scripts/smoke-unicode-provider-websocket.mjs",
		"smoke:zhipu-429-websocket": "node scripts/smoke-zhipu-429-websocket.mjs",
		"smoke:no-auto-model-switch": "node scripts/smoke-no-auto-model-switch.mjs",
		"smoke:context-compaction-websocket": "node scripts/smoke-unicode-provider-websocket.mjs --verify-compact-suite",
		"smoke:manual-context-compaction-websocket": "node scripts/smoke-unicode-provider-websocket.mjs --verify-manual-compact",
		"tauri": "tauri",
		"tauri:dev": "node scripts/tauri-dev.mjs",
		"tauri:build": "tauri build --config src-tauri/tauri.test.conf.json --no-sign",
		"tauri:build:standalone": "node scripts/build-standalone-tauri.mjs",
		"tauri:build:test": "pnpm tauri:build",
		"tauri:bundle": "node scripts/build-standalone-tauri.mjs --release",
		"format": "pnpm biome format --write scripts"
	},
	"dependencies": {
		"@a3s-lab/code": "file:../../vendor/a3s/selected/package"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.3.14",
		"@tauri-apps/cli": "^2",
		"@types/node": "^22.7.9",
		"rimraf": "^6.0.1",
		"socket.io-client": "^4.8.3",
		"typescript": "^5.6.3"
	}
}
